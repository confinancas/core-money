{
  "name": "app-fino-de-teste",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "node -e \"require('fs').mkdirSync('dist/client',{recursive:true})\"",
