{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Só para desenvolver o núcleo; o de cada app fica no repositório dele.
  "name": "matrimoney",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    // só /api/* executa o Worker; o resto é arquivo estático
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      // marcador para o D1 local
      "database_name": "matrimoney-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true },
  // Um Cron Trigger só, como despachante (plano-gratuito.md). O deploy de medição tira este bloco.
  "triggers": { "crons": ["*/5 * * * *"] },
  // Fila da importação do histórico, uma fatia por vez (TASK-0204).
  "queues": {
    "producers": [{ "binding": "SYNC_QUEUE", "queue": "matrimoney-sync" }],
    "consumers": [{ "queue": "matrimoney-sync", "max_batch_size": 1, "max_retries": 3, "max_concurrency": 1 }]
  }
}
