{
  "name": "matrimoney-spike",
  "version": "1.0.0",
  "scripts": {
    "icons": "node scripts/make-icons.mjs",
    "build": "vite build",
    "typecheck": "tsc",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply matrimoney-spike-db --remote",
    "deploy": "vite build && wrangler deploy"
  },
  "private": "true",
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261102.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "wrangler": "^4.156.1"
  }
}
